# Redis (docker compose up -d, or a local redis-server) — queue + job status
REDIS_URL=redis://localhost:6379/0

# MongoDB — crawled pages, site profiles, job records
MONGO_URL=mongodb://192.168.0.102:27017/
MONGO_DB=mt-scrapy-crawl
# Set false to run file-only (JSONL + CSV) with no database
MONGO_ENABLED=true

# Origins allowed to call the API (JSON array)
CORS_ORIGINS=["http://localhost:3000"]

# Crawl scope. There is no depth limit: every internal link is followed.
# 0 = crawl the whole site. A positive value caps the pages stored.
DEFAULT_MAX_PAGES=0
# Absolute backstop against crawl traps, applied even when max_pages is 0.
CRAWL_PAGE_CEILING=10000
# Tag/category/author/pagination listings are followed for link discovery but
# not stored. Set true to keep them.
STORE_ARCHIVE_PAGES=false

# Worker / Scrapy
JOB_TIMEOUT_SECONDS=3600
# How long a paused crawl gets to flush its queue to JOBDIR before it is
# killed. Overrunning this loses the frontier, so a resume restarts instead.
PAUSE_GRACE_SECONDS=30
# Render JS shuts down far more slowly: Playwright closes every browser
# context before Scrapy can finish.
PAUSE_GRACE_SECONDS_JS=180
SCRAPY_LOG_LEVEL=INFO
# Cache responses on disk between runs. Dev only.
HTTPCACHE_ENABLED=false

USER_AGENT=MyraCrawlPOC/0.1 (+https://github.com/myra/scraper-poc; website ingestion proof of concept)
